# Modified from slop-basefold-prover 6.4.0 by the sp1-metal project; see CHANGES.md.
[package]
name = "slop-basefold-prover"
description = "BaseFold prover implementation with FRI integration"
readme = "README.md"
version.workspace = true
edition.workspace = true
license.workspace = true
repository.workspace = true
keywords.workspace = true
categories.workspace = true

[features]
metal = ["dep:sp1-metal-core"]

[dependencies]
slop-algebra = { workspace = true }
slop-multilinear = { workspace = true }
slop-basefold = { workspace = true }
slop-futures = { workspace = true }
slop-challenger = { workspace = true }
slop-dft = { workspace = true }
slop-commit = { workspace = true }
slop-tensor = { workspace = true }
slop-alloc = { workspace = true }
slop-baby-bear = { workspace = true }
slop-koala-bear = { workspace = true }
slop-merkle-tree = { workspace = true }
slop-fri = { workspace = true }
slop-bn254 = { workspace = true }
itertools = { workspace = true }
rand = { workspace = true }
rayon = { workspace = true }
serde = { workspace = true, features = ["derive"] }
thiserror = { workspace = true }
derive-where = { workspace = true }


[dev-dependencies]
futures = { workspace = true }
sp1-metal-core = { path = "../../sp1-metal-core", optional = true }
